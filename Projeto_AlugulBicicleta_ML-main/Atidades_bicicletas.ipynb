   "source": [
    "from sklearn.linear_model import LinearRegression\n",
    "\n",
    "X = [[10], [15], [20], [25], [30], [35], [40], [50], [55], [60]]\n",
    "y = [10, 13, 14, 18, 19, 23, 24, 30, 32, 34]\n",
    "\n",
    "modelo = LinearRegression()\n",
    "modelo.fit(X, y)\n",
    "\n",
    "print(f\"Preço para 45 minutos: R$ {modelo.predict([[45]])[0]:.2f}\")"
   ]
  }
